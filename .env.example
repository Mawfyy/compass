# AI provider: "mock" (deterministic scaffold), "jev" (TypeSafe judgments), or "openrouter" (generative LLM)
PROVIDER=mock

# TypeSafe / Jev (judgment decisions). When set alongside PROVIDER=openrouter,
# Jev also classifies each goal (level, kind, depth, domain, hands-on, timeline)
# to tailor guide and map output. Set the key to opt in.
TYPESAFE_API_KEY=
# Optional: defaults to "jev-latest"
TYPESAFE_MODEL=jev-latest

# OpenRouter (generative map generation)
OPENROUTER_API_KEY=
# Optional: defaults to "google/gemini-3.8-flash" (fast, structured outputs)
# Alternatives: "deepseek/deepseek-v4-flash-0731" (slower, higher quality), "openai/gpt-4.1-nano"
OPENROUTER_MODEL=google/gemini-3.8-flash
# Optional: defaults to "https://openrouter.ai/api/v1"
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: defaults to 60000 (ms)
OPENROUTER_TIMEOUT_MS=60000

# Study Guide model (optional): defaults to OPENROUTER_MODEL, then "google/gemini-3.8-flash"
OPENROUTER_GUIDE_MODEL=google/gemini-3.8-flash
