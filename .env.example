# AI provider: "mock" (deterministic scaffold) or "openrouter" (generative LLM)
PROVIDER=mock

# OpenRouter (generative guide generation)
OPENROUTER_API_KEY=
# Optional: defaults to "google/gemini-3.8-flash" (fast, structured outputs)
# Alternatives: "deepseek/deepseek-v4-flash-0731" (slower, higher quality), "openai/gpt-4.1-nano"
OPENROUTER_MODEL=google/gemini-3.8-flash
# Optional: defaults to "https://openrouter.ai/api/v1"
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: defaults to 120000 (ms)
OPENROUTER_TIMEOUT_MS=120000

# Study Guide model (optional): defaults to OPENROUTER_MODEL, then "google/gemini-3.8-flash"
OPENROUTER_GUIDE_MODEL=google/gemini-3.8-flash
